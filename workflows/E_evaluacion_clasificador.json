    {
      "id": "4ccbe3c7-8241-4c66-8fb0-8d191d7f4514",
      "name": "Armar llamada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        128
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Una llamada a OpenAI por ticket, con el prompt leído desde Supabase.\nconst cfg = $('Configuración').first().json;\nconst prompt = $('Leer prompt').first().json.texto;\nconst t = $json;\nreturn { json: {\n  inicio: Date.now(),\n  body: {\n    model: cfg.modelo,\n    temperature: 0,\n    response_format: { type: 'json_object' },\n    messages: [\n      { role: 'system', content: prompt },\n      { role: 'user', content: 'País del cliente (formulario): ' + t.pais + '\\nTicket: ' + t.asunto + ' — ' + t.cuerpo }\n    ]\n  }\n}};"
      }
    },
    {
      "id": "56e6cb16-0b4d-4fe4-a03c-815973a1c589",
      "name": "P1 · Clasificar (OpenAI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1168,
        128
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 60000,
          "batching": {
            "batch": {
              "batchSize": 5,
              "batchInterval": 1000
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "8d3430ee-a262-42b4-a07c-e623e031c5df",
      "name": "Validar JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1392,
        128
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Valida el JSON contra el esquema y arma la fila de `clasificaciones`.\nconst r = $json;\nconst ticket = $('Leer set de prueba').item.json;\nconst req = $('Armar llamada').item.json;\nconst cfg = $('Configuración').first().json;\nconst ENUM = {\n  severidad: ['P1','P2','P3','P4'],\n  origen_falla: ['truora','fuente_externa_gobierno','meta_whatsapp','integracion_cliente','usuario_final','no_aplica','indeterminado'],\n  accion_sugerida: ['escalar_ingenieria','comunicado_proactivo','responder_con_kb','pedir_datos'],\n};\nlet c = {}, valido = true, error = null;\ntry { c = JSON.parse(r.choices[0].message.content); }\ncatch (e) { valido = false; error = 'JSON inválido: ' + e.message; }\nfor (const [campo, permitidos] of Object.entries(ENUM)) {\n  if (!permitidos.includes(c[campo])) { valido = false; error = (error ? error + '; ' : '') + campo + ' fuera de esquema: ' + c[campo]; c[campo] = null; }\n}\nconst conf = Number(c.confianza);\nreturn { json: {\n  ticket_id: ticket.id,\n  modelo: cfg.modelo,\n  prompt_version: cfg.prompt_version,\n  producto: c.producto ?? null,\n  pais: c.pais ?? null,\n  ambiente: c.ambiente ?? null,\n  tipo: c.tipo ?? null,\n  origen_falla: c.origen_falla,\n  codigo_motivo: c.codigo_motivo ?? null,\n  severidad: c.severidad,\n  confianza: Number.isFinite(conf) ? Math.min(Math.max(conf, 0), 1) : null,\n  justificacion: c.justificacion ?? null,\n  datos_faltantes: Array.isArray(c.datos_faltantes) ? c.datos_faltantes : [],\n  requiere_escalamiento: c.requiere_escalamiento === true,\n  accion_sugerida: c.accion_sugerida,\n  json_crudo: c,\n  json_valido: valido,\n  error,\n  latencia_ms: Date.now() - req.inicio,\n  tokens_entrada: r.usage?.prompt_tokens ?? null,\n  tokens_salida: r.usage?.completion_tokens ?? null,\n}};"
      }
    },
