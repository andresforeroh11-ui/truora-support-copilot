      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Cambia CORRIDA antes de cada ejecución (1, 2, 3...). PROMPT_VERSION debe existir en la tabla prompts.\nreturn [{ json: { corrida: 2, prompt_version: 'P1-v3', modelo: 'gpt-4o-mini' } }];"
      }
    },
    {
      "id": "0b4614cb-e801-4c0b-ab54-f2c7e804ec8e",
      "name": "Leer prompt",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        448,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "prompts",
        "returnAll": false,
        "limit": 1,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "version",
              "condition": "eq",
              "keyValue": "={{ $json.prompt_version }}"
