      "executeOnce": true
    },
    {
      "id": "97f9e4af-1c26-465f-9e33-36667c8cbc47",
      "name": "Leer set de prueba",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        672,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "tickets",
        "returnAll": true,
        "orderBy": "ticket_ref",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
