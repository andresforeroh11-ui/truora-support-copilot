    {
      "id": "1fb504ce-eaff-4183-92e7-5b9589dfc040",
      "name": "Interpretar acción",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        288
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Interpreta el botón (ap/ed/re) o la respuesta con el texto editado.\nconst u = $input.first().json;\nif (u.callback_query) {\n  const cq = u.callback_query;\n  const [pref, id] = String(cq.data || '').split(':');\n  const mapa = { ap: 'aprobar', ed: 'editar', re: 'rechazar' };\n  return [{ json: { accion: mapa[pref] || 'ignorar', respuesta_id: id, query_id: cq.id, chat_id: cq.message.chat.id } }];\n}\nconst m = u.message;\nconst ref = m && m.reply_to_message && String(m.reply_to_message.text || '').match(/ID: ([0-9a-f-]{36})/);\nif (ref && m.text) {\n  return [{ json: { accion: 'guardar_edicion', respuesta_id: ref[1], texto: m.text, query_id: null, chat_id: m.chat.id } }];\n}\nreturn [];"
      }
    },
