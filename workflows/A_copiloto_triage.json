    {
      "id": "f460abd4-7011-48e9-8ece-4d6b5d5879ef",
      "name": "Componer mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2480,
        80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Mensaje para el líder/N1 en Telegram (HTML escapado, máx. ~3.500 caracteres).\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst corta = (s, n) => { s = String(s ?? ''); return s.length > n ? s.slice(0, n) + '…' : s; };\nconst c = $('Validar JSON').first().json;\nconst t = $('Guardar ticket').first().json;\nconst resp = $('Guardar respuesta').first().json;\nlet ficha = null;\ntry { ficha = $('Guardar escalamiento').first().json.ficha; } catch (e) { ficha = null; }\nconst icono = { P1: '🔴', P2: '🟠', P3: '🟡', P4: '⚪' }[c.severidad] || '❓';\nconst lineas = [\n  icono + ' <b>' + esc(c.severidad) + ' · ' + esc(c.origen_falla || 'sin origen') + '</b>',\n  esc(t.cliente) + ' (' + esc(c.pais) + ') · ' + esc(c.producto) + ' · ' + esc(c.ambiente || 'ambiente ?'),\n  '<i>' + esc(t.asunto) + '</i>',\n  '',\n  'Acción: <b>' + esc(c.accion_sugerida) + '</b>' + (c.requiere_escalamiento ? ' → ESCALADO A INGENIERÍA' : ''),\n  'Por qué: ' + esc(c.justificacion),\n  'Pedir al cliente: ' + esc(c.datos_faltantes.length ? c.datos_faltantes.join('; ') : 'nada'),\n  '',\n  '<b>✍️ ' + (resp.tipo === 'comunicado' ? 'Comunicado proactivo' : 'Borrador de respuesta') + '</b> (pendiente de aprobación)',\n  esc(corta(resp.borrador, 1500)),\n];\nif (ficha && typeof ficha === 'object') {\n  lineas.push('', '<b>🛠 Ficha para Ingeniería</b>', esc(ficha.titulo),\n    'Hipótesis: ' + esc(ficha.hipotesis) + ' (certeza ' + esc(ficha.certeza) + ')',\n    'Revisar: ' + esc((ficha.que_revisar || []).slice(0, 4).join(' · ')));\n}\nif (!c.json_valido) lineas.push('', '⚠️ Revisar clasificación: ' + esc(c.error));\nreturn [{ json: { mensaje: lineas.join('\\n'), respuesta_id: resp.id } }];"
      }
    },
    {
      "id": "3f7936f7-cf51-43b4-95a3-bf657671bd1b",
