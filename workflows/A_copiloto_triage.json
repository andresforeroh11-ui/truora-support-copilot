    {
      "id": "6d187407-cd3c-4921-9e60-c61c4b5a2963",
      "name": "Armar llamada P2",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1696,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// P2: borrador con SOLO la KB pertinente (artículos por origen + motivo de rechazo).\nconst prompts = Object.fromEntries($('Leer prompts activos').all().map(i => [i.json.nombre, i.json]));\nconst c = $('Validar JSON').first().json;\nconst t = $('Guardar ticket').first().json;\nconst motivo = $('Leer motivo KB').first().json || {};\nconst arts = $('Leer artículos KB').all().map(i => i.json)\n  .filter(a => a.slug && String(a.origen_falla || '').split('|').includes(c.origen_falla));\nconst kb = arts.length ? arts.map(a => '### ' + a.titulo + '\\n' + a.contenido).join('\\n\\n') : 'No hay artículos para este origen.';\nconst motivoTxt = motivo.codigo\n  ? 'Código: ' + motivo.codigo + '\\nQué significa: ' + (motivo.explicacion_es || motivo.descripcion_en) +\n    '\\nQué debe hacer el usuario final: ' + (motivo.accion_usuario_final || 'no documentado') +\n    '\\nQué debe hacer el cliente: ' + (motivo.accion_cliente || 'no documentado') +\n    '\\nTono: ' + (motivo.nota_tono || 'sin indicaciones')\n  : 'Sin motivo de rechazo.';\nconst clasif = { severidad: c.severidad, origen_falla: c.origen_falla, accion_sugerida: c.accion_sugerida, codigo_motivo: c.codigo_motivo, producto: c.producto, ambiente: c.ambiente, datos_faltantes: c.datos_faltantes };\nconst user = 'Ticket\\nCliente: ' + t.cliente + '\\nPaís: ' + c.pais + '\\nAsunto: ' + t.asunto + '\\nDescripción: ' + t.cuerpo +\n  '\\n\\nClasificación\\n' + JSON.stringify(clasif) +\n  '\\n\\nArtículos de conocimiento\\n' + kb + '\\n\\nMotivo de rechazo\\n' + motivoTxt;\nreturn [{ json: {\n  kb_usada: arts.map(a => a.slug).concat(motivo.codigo ? ['motivo:' + motivo.codigo] : []),\n  body: { model: 'gpt-4o-mini', temperature: 0.3, messages: [ { role: 'system', content: prompts.P2.texto }, { role: 'user', content: user } ] }\n}}];"
      }
    },
