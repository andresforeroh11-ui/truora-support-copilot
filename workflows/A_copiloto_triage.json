      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Prompts activos desde Supabase (P1, P2, P3) y llamada de clasificación.\nconst prompts = Object.fromEntries($('Leer prompts activos').all().map(i => [i.json.nombre, i.json]));\nconst t = $('Guardar ticket').first().json;\nreturn [{ json: {\n  inicio: Date.now(),\n  modelo: 'gpt-4o-mini',\n  prompt_version: prompts.P1.version,\n  body: {\n    model: 'gpt-4o-mini',\n    temperature: 0,\n    response_format: { type: 'json_object' },\n    messages: [\n      { role: 'system', content: prompts.P1.texto },\n      { role: 'user', content: 'País del cliente (formulario): ' + t.pais + '\\nTicket: ' + t.asunto + ' — ' + t.cuerpo }\n    ]\n  }\n}}];"
      }
    },
    {
      "id": "9ce744af-8b9b-407f-96ac-ec6f6945808b",
      "name": "P1 · Clasificar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        944,
        288
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 60000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "e694f35d-1bff-4cb3-85b1-e2a6c6ce852c",
      "name": "Validar JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1168,
        288
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Valida el JSON de P1 contra el esquema. El país del formulario manda si el modelo no lo detecta.\nconst r = $input.first().json;\nconst req = $('Armar llamada P1').first().json;\nconst ticket = $('Guardar ticket').first().json;\nconst ENUM = {\n  severidad: ['P1','P2','P3','P4'],\n  origen_falla: ['truora','fuente_externa_gobierno','meta_whatsapp','integracion_cliente','usuario_final','no_aplica','indeterminado'],\n  accion_sugerida: ['escalar_ingenieria','comunicado_proactivo','responder_con_kb','pedir_datos'],\n};\nlet c = {}, valido = true, error = null;\ntry { c = JSON.parse(r.choices[0].message.content); }\ncatch (e) { valido = false; error = 'JSON inválido: ' + e.message; }\nfor (const [campo, permitidos] of Object.entries(ENUM)) {\n  if (!permitidos.includes(c[campo])) { valido = false; error = (error ? error + '; ' : '') + campo + ' fuera de esquema: ' + c[campo]; c[campo] = null; }\n}\nif (!c.severidad) { c.severidad = 'P2'; }\nif (!c.accion_sugerida) { c.accion_sugerida = 'pedir_datos'; }\nconst conf = Number(c.confianza);\nconst pais = ['MX','BR','CO','CL','PE'].includes(c.pais) ? c.pais : ticket.pais;\nreturn [{ json: {\n  ticket_id: ticket.id,\n  modelo: req.modelo,\n  prompt_version: req.prompt_version,\n  producto: c.producto ?? 'otro',\n  pais,\n  ambiente: c.ambiente ?? null,\n  tipo: c.tipo ?? null,\n  origen_falla: c.origen_falla,\n  codigo_motivo: c.codigo_motivo ?? null,\n  severidad: c.severidad,\n  confianza: Number.isFinite(conf) ? Math.min(Math.max(conf, 0), 1) : null,\n  justificacion: c.justificacion ?? null,\n  datos_faltantes: Array.isArray(c.datos_faltantes) ? c.datos_faltantes : [],\n  requiere_escalamiento: c.requiere_escalamiento === true,\n  accion_sugerida: c.accion_sugerida,\n  json_crudo: c,\n  json_valido: valido,\n  error,\n  latencia_ms: Date.now() - req.inicio,\n  tokens_entrada: r.usage?.prompt_tokens ?? null,\n  tokens_salida: r.usage?.completion_tokens ?? null,\n}}];"
      }
    },
