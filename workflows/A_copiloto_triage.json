    {
      "id": "7138ae9c-a37d-48b8-be2e-981c58673daa",
      "name": "Evaluar incidente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1696,
        384
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Incidente = 3+ tickets del mismo producto y país en 30 min. La firma dice a quién le toca.\nconst actual = $('Validar JSON').first().json;\nconst rec = $('Leer clasificaciones recientes').all().map(i => i.json).filter(r => r.id);\nconst abiertos = $('Leer incidentes abiertos').all().map(i => i.json).filter(r => r.id);\nif (rec.length < 3 || abiertos.length) return [];\nconst n = (o) => rec.filter(r => r.origen_falla === o).length;\nlet firma = null;\nif (n('fuente_externa_gobierno') >= rec.length / 2) firma = 'fuente_externa';\nelse if (n('truora') + n('indeterminado') >= rec.length / 2) firma = 'plataforma';\nif (!firma) return [];\nconst conteo = {};\nfor (const r of rec) if (r.codigo_motivo) conteo[r.codigo_motivo] = (conteo[r.codigo_motivo] || 0) + 1;\nconst codigo = Object.keys(conteo).sort((a, b) => conteo[b] - conteo[a])[0] || null;\nconst base = rec.length + ' tickets de ' + actual.producto + ' en ' + actual.pais + ' en los últimos 30 min.';\nconst mensaje = firma === 'fuente_externa'\n  ? '🚨 <b>Posible incidente: FUENTE EXTERNA</b>\\n' + base + (codigo ? '\\nCódigo común: ' + codigo : '') +\n    '\\n<b>Acción:</b> confirmar en status.truora.com, enviar comunicado proactivo a los clientes del país y no escalar a Ingeniería.'\n  : '🚨 <b>Posible incidente de PLATAFORMA</b>\\n' + base +\n    '\\n<b>Acción:</b> abrir incidente con Ingeniería (adjuntar fichas P3) y comunicar a los clientes afectados.';\nreturn [{ json: { producto: actual.producto, pais: actual.pais, firma, codigo_motivo: codigo, ticket_ids: rec.map(r => r.ticket_id), mensaje_alerta: mensaje } }];"
      }
    },
