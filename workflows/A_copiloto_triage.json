      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// P3: ficha de escalamiento solo cuando el origen es la plataforma (o indeterminado P1/P2).\nconst prompts = Object.fromEntries($('Leer prompts activos').all().map(i => [i.json.nombre, i.json]));\nconst c = $('Validar JSON').first().json;\nconst t = $('Guardar ticket').first().json;\nconst user = 'Ticket\\nCliente: ' + t.cliente + '\\nPaís: ' + c.pais + '\\nAsunto: ' + t.asunto + '\\nDescripción: ' + t.cuerpo +\n  '\\n\\nClasificación\\n' + JSON.stringify({ severidad: c.severidad, origen_falla: c.origen_falla, producto: c.producto, ambiente: c.ambiente, codigo_motivo: c.codigo_motivo, justificacion: c.justificacion, datos_faltantes: c.datos_faltantes });\nreturn [{ json: { body: { model: 'gpt-4o-mini', temperature: 0, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: prompts.P3.texto }, { role: 'user', content: user } ] } } }];"
