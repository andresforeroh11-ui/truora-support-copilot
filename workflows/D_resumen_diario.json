      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "c50fafe1-cba8-4f95-bca9-2a13b4681197",
      "name": "Guardar resumen",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1168,
        224
      ],
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "resumenes_diarios",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "metricas",
              "fieldValue": "={{ $('Armar llamada P4').first().json.metricas }}"
            },
            {
              "fieldId": "texto",
              "fieldValue": "={{ $json.choices[0].message.content }}"
            }
          ]
        }
      }
    },
    {
      "id": "f80efa5f-f90d-4189-b4d7-12e0e9f1bb56",
      "name": "Componer resumen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1392,
        224
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst texto = $('P4 · Resumen del líder').first().json.choices[0].message.content;\nconst m = $('Armar llamada P4').first().json.metricas || {};\nconst titulos = ['Estado:', 'SLA en riesgo:', 'Incidentes:', 'Patrones:', 'Calidad de la IA:', 'Prioridad de hoy:'];\nlet cuerpo = esc(texto);\nfor (const t of titulos) cuerpo = cuerpo.split(t).join('<b>' + t + '</b>');\n// Detalle fijo desde SQL: números de caso y desde cuándo ocurre (no lo escribe la IA)\nconst lista = (v) => Array.isArray(v) ? v : (typeof v === 'string' ? JSON.parse(v || '[]') : []);\nconst casos = (arr) => (arr || []).map(x => '#' + x).join(', ');\nconst det = [];\nconst ejemplos = [];\nfor (const i of lista(m.incidentes)) {\n  ejemplos.push(...(i.casos || []));\n  det.push('🚨 ' + esc(i.firma === 'fuente_externa' ? 'Fuente externa' : 'Plataforma') + ' · ' + esc(i.producto) + ' ' + esc(i.pais) +\n    ' · casos ' + esc(casos(i.casos)) + ' · desde ' + esc(i.desde) + ' (' + esc(i.estado) + ')');\n}\nfor (const s of lista(m.sla_en_riesgo)) {\n  ejemplos.push(s.caso);\n  det.push('⏱ #' + esc(s.caso) + ' ' + esc(s.severidad) + ' · ' + esc(s.cliente) + ' · desde ' + esc(s.desde) +\n    ' · ' + esc(s.minutos_abierto) + ' de ' + esc(s.limite_min) + ' min');\n}\nfor (const p of lista(m.patrones)) {\n  ejemplos.push(...(p.casos || []));\n  det.push('🔁 ' + esc(p.patron) + ' · casos ' + esc(casos(p.casos)));\n}\nconst detalle = det.length ? '\\n\\n<b>Casos a revisar</b>\\n' + det.slice(0, 15).join('\\n') +\n  (ejemplos.length ? '\\n\\n💬 Pregunta por uno: <code>caso ' + esc(ejemplos[0]) + '</code> y tu pregunta.' : '') : '';\nconst fecha = $now.setZone('America/Bogota').toFormat('dd/MM HH:mm');\nreturn [{ json: { mensaje: '☀️ <b>Resumen de soporte · ' + fecha + '</b>\\n\\n' + cuerpo + detalle } }];"
      }
    },
