    {
      "id": "48ef75f7-7a43-4e16-b3dd-b7b6ea8a832d",
      "name": "Armar llamada P4",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        224
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Las cifras vienen de SQL; la IA solo las interpreta.\nconst m = $('Leer métricas 24 h').first().json;\nconst p = $('Leer prompt P4').first().json;\nreturn [{ json: { metricas: m, body: { model: 'gpt-4o-mini', temperature: 0.2, messages: [ { role: 'system', content: p.texto }, { role: 'user', content: JSON.stringify(m) } ] } } }];"
      }
    },
    {
      "id": "8e749da8-892a-4630-bfcd-fdf1539de254",
      "name": "P4 · Resumen del líder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        944,
        224
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
