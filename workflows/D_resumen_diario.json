    {
      "id": "3fca752f-066d-4423-9925-94dc570cf1be",
      "name": "Armar correo del resumen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1840,
        400
      ],
      "parameters": {
        "jsCode": "// El mismo resumen de Telegram, en HTML para correo.\nconst dest = Object.fromEntries($('Leer destinatarios').all().map(i => [i.json.rol, i.json.correo]));\nconst msg = $('Componer resumen').first().json.mensaje;\nconst fecha = $now.setZone('America/Bogota').setLocale('es').toFormat('ccc d LLL yyyy');\nconst html = '<div style=\"font-family:Arial,sans-serif;font-size:14px;color:#222;max-width:680px;line-height:1.5\">' +\n  msg.replace(/<code>/g, '<code style=\"background:#f2f2f2;padding:1px 4px;border-radius:3px\">').replace(/\\n/g, '<br>') +\n  '<hr style=\"border:none;border-top:1px solid #ddd\"><p style=\"color:#888;font-size:12px\">Cifras calculadas en SQL (v_resumen_diario); la IA solo las redacta. DEMO: datos sintéticos.</p></div>';\nreturn [{ json: { para: dest.lider, asunto: 'Resumen de soporte · ' + fecha, html } }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      }
    },
