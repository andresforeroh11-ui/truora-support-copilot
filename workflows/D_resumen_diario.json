      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Las cifras vienen de SQL; la IA solo las interpreta.\nconst m = $('Leer métricas 24 h').first().json;\nconst p = $('Leer prompt P4').first().json;\nreturn [{ json: { metricas: m, body: { model: 'gpt-4o-mini', temperature: 0.2, messages: [ { role: 'system', content: p.texto }, { role: 'user', content: JSON.stringify(m) } ] } } }];"
      }
